      "intentional_differences": [
        {
          "category": "units",
          "description": "The public interface uses explicit kelvin, grams, centimeters, seconds, GeV, and inverse cubic centimeters instead of natural-unit library types.",
          "behavior_change": false
        },
        {
          "category": "data_loading",
          "description": "Construction requires explicit paths to project-owned table copies and has no PROJECT_DIR locator or reference-checkout fallback.",
          "behavior_change": true
        },
        {
          "category": "data_format",
          "description": "Project copies normalize record formatting only: Nuclear_Data.txt uses LF instead of legacy CR delimiters, and the AGSS09 table drops trailing horizontal whitespace and gains a final LF; data fields and attribution text are unchanged.",
          "behavior_change": false
        },
        {
          "category": "validation_and_domain",
          "description": "Malformed inputs and invalid radii raise exceptions; exterior enclosed mass stays at the solar mass, target number density vanishes, escape speed uses the point-mass solution, and exterior temperature is rejected.",
          "behavior_change": true
        },
        {
          "category": "input_contract",
          "description": "The loader accepts the fixed 35-column, 1968-row AGSS09 table shape and required radial endpoints used by this project rather than an open-ended solar-table format.",
          "behavior_change": true
        }
      ],
      "preserved_behaviors": [
        {
          "id": "horner_interpolation",
          "description": "Steffen interval polynomials use the patched Horner evaluation order from the fixed reference checkout."
        },
        {
          "id": "escape_profile_numerics",
          "description": "Each escape-speed-squared node uses one 30-point Gauss-Legendre integral over the full radial interval; escape-speed squared is interpolated before taking the square root."
        },
        {
          "id": "number_density_order",
          "description": "Each isotope number density is formed at every radial node before its own Steffen interpolation is constructed."
        },
        {
          "id": "isotopic_abundances",
          "description": "Nuclear_Data.txt isotope abundances are used verbatim, including the calcium entries whose sum is 1.00003; they are not renormalized."
        }
      ]
    }
